# ===========================
# 1. Build Output (Maven & Gradle)
# ===========================
target/
build/
out/
bin/
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/
*.class
*.jar
*.war
*.ear
*.nar

